# Plantilla para firma de release de Android en MercuryGO.
# Copiar este archivo como 'keystore.properties' en esta misma carpeta (android/)
# y completar con los datos de tu almacén de claves (keystore/jks).
#
# Para generar un keystore nuevo con keytool:
# keytool -genkey -v -keystore app/mercurygo-release.jks -alias mercurygo -keyalg RSA -keysize 2048 -validity 10000

storeFile=app/mercurygo-release.jks
storePassword=tu_password_del_almacen
keyAlias=mercurygo
keyPassword=tu_password_de_la_clave
