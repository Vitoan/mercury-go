# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
coverage/
dist/
node_modules/
platforms/
plugins/
www/

# .NET / C#
bin/
obj/
*.user
*.userosscache
*.sln.docstates
.vs/
_ReSharper*/

# Environment & Sensitive
.env
.env.*
!.env.development
!.env.release
*.local
google-services.json
firebase-service-account.json
*firebase*.json
keystore.properties
*.jks
*.keystore
appsettings.Production.json
*.publishSettings
*.PublishSettings
*.zip
publish/

# CodeGraph
.codegraph/
graphify-out/

